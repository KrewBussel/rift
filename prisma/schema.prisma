generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Firm {
  id                  String              @id @default(cuid())
  name                String
  // URL slug for the firm's subdomain: <slug>.riftira.com.
  // Lowercase [a-z0-9-]{3,63}, globally unique, reserved-list filtered.
  // Auto-generated from `name` for firms that predate the slug step in
  // the onboarding wizard; admins can change it later in Settings.
  slug                String              @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  legalName           String?
  taxId               String?
  businessAddress     String?
  supportEmail        String?
  supportPhone        String?
  websiteUrl          String?
  logoUrl             String?
  planTier            PlanTier            @default(STARTER)
  seatsLimit          Int                 @default(5)
  billingEmail        String?
  renewalDate         DateTime?
  stripeCustomerId    String?
  aiMonthlyTokenLimit Int                 @default(500000)
  aiPlanName          String              @default("Starter")
  // null until the admin finishes the onboarding wizard. While null, the
  // dashboard redirects to /onboarding for ADMIN users.
  onboardedAt         DateTime?
  aiUsageLogs         AIUsageLog[]
  auditLogs           AuditLog[]
  clientAccessTokens  ClientAccessToken[]
  clientSessions      ClientSession[]
  custodianNotes      CustodianNote[]
  settings            FirmSettings?
  reminderLogs        ReminderLog[]
  cases               RolloverCase[]
  users               User[]
  crmConnection       CrmConnection?
  crmStageMappings    CrmStageMapping[]
  stageConfigs        CaseStageConfig[]
  deletedCrmOpportunities DeletedCrmOpportunity[]
}

model FirmSettings {
  id                     String   @id @default(cuid())
  firmId                 String   @unique
  remindersEnabled       Boolean  @default(true)
  stalledCaseDays        Int      @default(7)
  overdueTaskReminders   Boolean  @default(true)
  stalledCaseReminders   Boolean  @default(true)
  missingDocsReminders   Boolean  @default(false)
  operatingStates        String[] @default([])
  require2FA             Boolean  @default(false)
  complianceContactEmail String?
  allowDataExport        Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  firm                   Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
}

model ReminderLog {
  id          String   @id @default(cuid())
  firmId      String
  type        String
  referenceId String
  sentTo      String
  sentAt      DateTime @default(now())
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([type, referenceId, sentAt])
}

model User {
  id                String          @id @default(cuid())
  firstName         String
  lastName          String
  email             String          @unique
  password          String
  role              Role            @default(OPS)
  firmId            String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  preferences       Json?
  bio               String?
  emailSignature    String?
  twoFactorEnabled  Boolean         @default(false)
  twoFactorSecret   String?
  passwordUpdatedAt DateTime?
  lastLoginAt       DateTime?
  deactivatedAt     DateTime?
  aiUsageLogs       AIUsageLog[]
  activityEvents    ActivityEvent[]
  auditLogs         AuditLog[]
  passwordResetTokens PasswordResetToken[]
  issuedClientAccessTokens ClientAccessToken[] @relation("IssuedClientAccessTokens")
  custodianNotes    CustodianNote[]
  uploadedDocuments Document[]
  notes             Note[]
  assignedCases     RolloverCase[]  @relation("AssignedAdvisor")
  ownedCases        RolloverCase[]  @relation("AssignedOps")
  assignedTasks     Task[]          @relation("AssignedTasks")
  createdTasks      Task[]          @relation("CreatedTasks")
  deletedCrmOpportunities DeletedCrmOpportunity[]
  firm              Firm            @relation(fields: [firmId], references: [id])
}

model RolloverCase {
  id                   String          @id @default(cuid())
  clientFirstName      String
  clientLastName       String
  clientEmail          String
  sourceProvider       String
  destinationCustodian String
  accountType          AccountType
  status               CaseStatus      @default(PROPOSAL_ACCEPTED)
  highPriority         Boolean         @default(false)
  internalNotes        String?
  assignedAdvisorId    String?
  assignedOpsId        String?
  firmId               String
  statusUpdatedAt      DateTime        @default(now())
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  wealthboxOpportunityId String?
  wealthboxLinkedAt      DateTime?
  wealthboxLastSyncedAt  DateTime?
  wealthboxLastSyncError String?
  // Set to true when a case is auto-created from Wealthbox but is missing
  // one of the required custom fields (sourceProvider, destinationCustodian,
  // accountType). The user fills the gap, then clears the flag.
  needsReview            Boolean         @default(false)
  reviewReason           String?
  // Client phone, pulled from the Wealthbox contact's primary phone number on
  // case creation / refresh. Stored on the case so users don't bounce back to
  // the CRM to call a client.
  clientPhone            String?
  // Wealthbox-shadowed opportunity metadata. These are kept on the case as a
  // local snapshot — they're updated on case creation and on user-triggered
  // "Refresh from CRM", but never written back to Wealthbox. The opportunity
  // there remains the source of truth.
  wealthboxOpportunityName String?
  wealthboxAmount        Float?
  wealthboxAmountCurrency String?
  wealthboxTargetClose   DateTime?
  wealthboxProbability   Int?
  wealthboxOppCreatedAt  DateTime?
  activityEvents       ActivityEvent[]
  checklistItems       ChecklistItem[]
  clientAccessTokens   ClientAccessToken[]
  clientSessions       ClientSession[]
  documents            Document[]
  notes                Note[]
  assignedAdvisor      User?           @relation("AssignedAdvisor", fields: [assignedAdvisorId], references: [id])
  assignedOps          User?           @relation("AssignedOps", fields: [assignedOpsId], references: [id])
  firm                 Firm            @relation(fields: [firmId], references: [id])
  tasks                Task[]

  // One Rift case per Wealthbox opportunity per firm. NULLs are distinct in
  // Postgres, so unlinked/manual cases (wealthboxOpportunityId = null) are
  // unaffected. This constraint is what makes the inbound poller genuinely
  // idempotent under concurrent triggers. Its index also serves the poll dedup
  // and every firmId-prefixed scan.
  @@unique([firmId, wealthboxOpportunityId])
  @@index([firmId, status])
}

model ActivityEvent {
  id              String         @id @default(cuid())
  caseId          String
  actorUserId     String?
  clientSessionId String?
  eventType       EventType
  eventDetails    String?
  createdAt       DateTime       @default(now())
  actor           User?          @relation(fields: [actorUserId], references: [id])
  case            RolloverCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  clientSession   ClientSession? @relation(fields: [clientSessionId], references: [id], onDelete: SetNull)
}

model Task {
  id          String       @id @default(cuid())
  caseId      String
  title       String
  description String?
  assigneeId  String?
  dueDate     DateTime?
  status      TaskStatus   @default(OPEN)
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignee    User?        @relation("AssignedTasks", fields: [assigneeId], references: [id])
  case        RolloverCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("CreatedTasks", fields: [createdById], references: [id])
}

model Note {
  id           String       @id @default(cuid())
  caseId       String
  authorUserId String?
  fromClient   Boolean      @default(false)
  body         String
  createdAt    DateTime     @default(now())
  author       User?        @relation(fields: [authorUserId], references: [id])
  case         RolloverCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model ChecklistItem {
  id        String          @id @default(cuid())
  caseId    String
  name      String
  required  Boolean         @default(true)
  status    ChecklistStatus @default(NOT_STARTED)
  notes     String?
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  case      RolloverCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documents Document[]
}

model Document {
  id                        String         @id @default(cuid())
  caseId                    String
  checklistItemId           String?
  name                      String
  storagePath               String
  fileType                  String
  fileSize                  Int
  // Exactly one of these is set:
  //   uploadedById                — firm user uploaded
  //   uploadedByClientSessionId   — end client uploaded via the portal
  // Both nullable on the table; the API enforces the XOR.
  uploadedById              String?
  uploadedByClientSessionId String?
  createdAt                 DateTime       @default(now())
  case                      RolloverCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  checklistItem             ChecklistItem? @relation(fields: [checklistItemId], references: [id])
  uploadedBy                User?          @relation(fields: [uploadedById], references: [id])
  uploadedByClientSession   ClientSession? @relation(fields: [uploadedByClientSessionId], references: [id], onDelete: SetNull)
  review                    DocumentReview?
}

// AI paperwork QA result for one document. One row per document (re-scans
// overwrite). Written only by src/lib/documentReview.ts — runs on Bedrock so
// document contents never leave AWS. `findings` holds field names and issue
// types only, never transcribed values (PII minimization).
model DocumentReview {
  id         String                 @id @default(cuid())
  documentId String                 @unique
  status     DocumentReviewStatus   @default(PENDING)
  verdict    DocumentReviewVerdict?
  findings   Json?
  summary    String?
  error      String?
  modelUsed  String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  document   Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Custodian {
  id                      String                  @id @default(cuid())
  name                    String                  @unique
  legalName               String?
  aliases                 String[]                @default([])
  phone                   String?
  fax                     String?
  email                   String?
  website                 String?
  mailingAddress          String?
  overnightAddress        String?
  wireInstructions        String?
  typicalProcessingDays   Int?
  minProcessingDays       Int?
  maxProcessingDays       Int?
  signatureRequirements   String?
  medallionRequired       Boolean                 @default(false)
  medallionThreshold      Int?
  notarizationRequired    Boolean                 @default(false)
  acceptsElectronic       Boolean                 @default(false)
  acceptsDigitalSignature Boolean                 @default(false)
  supportsACATS           Boolean                 @default(true)
  overview                String?
  quirks                  String[]                @default([])
  commonForms             String[]                @default([])
  tags                    String[]                @default([])
  lastVerifiedAt          DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  mailingRoutes           CustodianMailingRoute[]
  notes                   CustodianNote[]

  @@index([name])
}

model CustodianNote {
  id          String    @id @default(cuid())
  custodianId String
  firmId      String
  authorId    String
  title       String
  body        String
  category    String?
  pinned      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User      @relation(fields: [authorId], references: [id])
  custodian   Custodian @relation(fields: [custodianId], references: [id], onDelete: Cascade)
  firm        Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([custodianId, firmId])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  firmId      String
  actorUserId String?
  action      String
  resource    String
  resourceId  String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id])
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, createdAt])
  @@index([action])
}

model AIUsageLog {
  id               String   @id @default(cuid())
  firmId           String
  userId           String
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  createdAt        DateTime @default(now())
  firm             Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id])

  @@index([firmId, createdAt])
}

model CustodianMailingRoute {
  id               String    @id @default(cuid())
  custodianId      String
  label            String
  states           String[]  @default([])
  mailingAddress   String?
  overnightAddress String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  custodian        Custodian @relation(fields: [custodianId], references: [id], onDelete: Cascade)

  @@index([custodianId])
}

model ClientAccessToken {
  id             String          @id @default(cuid())
  caseId         String
  firmId         String
  tokenHash      String          @unique
  scope          ClientScope     @default(FULL)
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  issuedByUserId String
  createdAt      DateTime        @default(now())
  case           RolloverCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  firm           Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  issuedBy       User            @relation("IssuedClientAccessTokens", fields: [issuedByUserId], references: [id])
  sessions       ClientSession[]

  @@index([caseId, revokedAt, consumedAt])
  @@index([expiresAt])
}

model ClientSession {
  id             String            @id @default(cuid())
  caseId         String
  firmId         String
  tokenId        String
  tokenHash      String            @unique
  scope          ClientScope
  expiresAt      DateTime
  revokedAt      DateTime?
  lastSeenAt     DateTime          @default(now())
  userAgent      String?
  ipAddress      String?
  createdAt      DateTime          @default(now())
  token          ClientAccessToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  case           RolloverCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  firm           Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  activityEvents ActivityEvent[]
  uploadedDocuments Document[]

  @@index([caseId, revokedAt])
  @@index([expiresAt])
}

enum ClientScope {
  VIEW
  UPLOAD
  FULL
}

model CrmConnection {
  id                    String      @id @default(cuid())
  firmId                String      @unique
  provider              CrmProvider
  encryptedToken        String
  tokenIv               String
  tokenTag              String
  connectedUserId       String?
  connectedUserName     String?
  connectedUserEmail    String?
  connectedAt           DateTime    @default(now())
  lastHealthCheckAt     DateTime?
  lastHealthOk          Boolean     @default(true)
  lastHealthError       String?
  // Written only at the end of an inbound poll. The page-load auto-sync throttle
  // keys off this (not lastHealthCheckAt, which outbound pushes also bump) so an
  // outbound stage push can't suppress inbound polling.
  lastPolledAt          DateTime?
  // Which Wealthbox opportunity pipeline feeds Rift. Wealthbox stage ids are
  // already pipeline-scoped, so this doesn't change what the poller scans — it
  // makes the choice explicit and auditable, scopes the stage pickers, and
  // anchors bookend auto-detection to a pipeline the admin actually chose
  // instead of one whose name happens to match /rollover|rift/. Null on firms
  // that predate the picker; the name is a display snapshot.
  pipelineId            String?
  pipelineName          String?
  // Opt-in inbound filter for firms whose chosen pipeline also carries
  // non-rollover business — the norm on Wealthbox plans capped at the single
  // "Default" pipeline, where a dedicated rollover pipeline isn't available.
  // When true, an opportunity only becomes a case if all three Rift custom
  // fields are present. Default false so firms on a dedicated pipeline keep
  // the existing create-and-flag-for-review behaviour.
  requireRolloverFields Boolean     @default(false)
  updatedAt             DateTime    @updatedAt
  firm                  Firm        @relation(fields: [firmId], references: [id], onDelete: Cascade)
}

model CrmStageMapping {
  id           String     @id @default(cuid())
  firmId       String
  riftStatus   CaseStatus
  crmStageId   String
  crmStageName String
  updatedAt    DateTime   @updatedAt
  firm         Firm       @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, riftStatus])
  // Reverse lookup used by refreshCaseFromCrm: firmId + crmStageId → riftStatus.
  @@index([firmId, crmStageId])
}

// Per-firm overlay on the canonical CaseStatus enum: lets a firm rename a
// stage as it appears in Rift and turn intermediate stages on/off. The two
// bookends (PROPOSAL_ACCEPTED, WON) are always isEnabled=true regardless of
// what's stored — the API enforces it.
model CaseStageConfig {
  id          String     @id @default(cuid())
  firmId      String
  status      CaseStatus
  customLabel String?
  isEnabled   Boolean    @default(true)
  sortOrder   Int
  updatedAt   DateTime   @updatedAt
  firm        Firm       @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, status])
  @@index([firmId, sortOrder])
}

// Tombstone for a Wealthbox opportunity whose Rift case was deleted.
//
// The inbound poller decides what's "new" by diffing the mapped Proposal
// Accepted stage against existing RolloverCase rows, so without this a deleted
// case is re-created on the very next poll (page-load auto-sync fires every
// 10s). A row here tells the poller to leave that opportunity alone. Manually
// re-linking a case to the opportunity clears the tombstone — that's an
// explicit "I do want this one" from the user.
model DeletedCrmOpportunity {
  id            String   @id @default(cuid())
  firmId        String
  opportunityId String
  deletedAt     DateTime @default(now())
  deletedById   String?
  firm          Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  deletedBy     User?    @relation(fields: [deletedById], references: [id])

  @@unique([firmId, opportunityId])
}

enum CrmProvider {
  WEALTHBOX
}

enum PlanTier {
  STARTER
  PRO
  ENTERPRISE
}

enum Role {
  ADMIN
  OPS
  ADVISOR
}

enum CaseStatus {
  PROPOSAL_ACCEPTED
  AWAITING_CLIENT_ACTION
  READY_TO_SUBMIT
  SUBMITTED
  PROCESSING
  IN_TRANSIT
  WON
}

enum AccountType {
  TRADITIONAL_IRA_401K
  ROTH_IRA_401K
  IRA_403B
  OTHER
}

enum EventType {
  CASE_CREATED
  CASE_UPDATED
  STATUS_CHANGED
  NOTE_ADDED
  OWNER_CHANGED
  TASK_CREATED
  TASK_COMPLETED
  TASK_REOPENED
  FILE_UPLOADED
  FILE_DELETED
  CHECKLIST_ITEM_UPDATED
}

enum TaskStatus {
  OPEN
  COMPLETED
  BLOCKED
}

enum ChecklistStatus {
  NOT_STARTED
  REQUESTED
  RECEIVED
  REVIEWED
  COMPLETE
}

enum DocumentReviewStatus {
  PENDING
  COMPLETE
  FAILED
}

enum DocumentReviewVerdict {
  PASS
  ISSUES_FOUND
  UNREADABLE
}
